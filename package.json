{
  "name": "notecat",
  "version": "0.4.16",
  "private": true,
  "description": "A minimal notes app with multi-note support",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig tsconfig.json --tsgo",
    "check:ts": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "prettier --check . && oxlint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript/native": "npm:typescript@7",
    "idb-keyval": "^6.3.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
